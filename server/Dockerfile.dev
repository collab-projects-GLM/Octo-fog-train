# Dev-only image for the Django API: deps come from uv, source is bind-mounted by compose.yml.
# server/Dockerfile (gunicorn, baked-in source) stays the production image.
FROM python:3.14-slim

COPY --from=ghcr.io/astral-sh/uv:0.12.10 /uv /uvx /bin/

ENV PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy

WORKDIR /app

# uid 1000 so files written into the bind-mounted source stay owned by the host user.
# The venv below is owned by this user too, which lets `uv run` re-sync it on start.
RUN useradd --uid 1000 --create-home app && chown app /app
USER app

# Dependencies first so this layer is cached until pyproject.toml / uv.lock change.
# uv.lock* is a glob so the build still works before a lockfile exists (uv creates one).
COPY --chown=app:app pyproject.toml uv.lock* ./
RUN uv sync --no-install-project

EXPOSE 8000
CMD ["uv", "run", "python", "manage.py", "runserver", "0.0.0.0:8000"]
