DJANGO_SECRET_KEY=replace-with-a-new-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Hosted Postgres (e.g. Neon). When set it wins over POSTGRES_* below; leave unset for local docker.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Local docker Postgres (compose.yml)
POSTGRES_DB=octo_travel
POSTGRES_USER=octo
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Storage backend: local or r2
S3_STORAGE_BACKEND=local

# Local RustFS
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=your_local_access_key
S3_SECRET_KEY=your_local_secret_key
S3_BUCKET_NAME=octo-travel
S3_REGION=us-east-1

# Backblaze B2 (S3-compatible) - swap these in for the local RustFS values above
# S3_ENDPOINT_URL=https://s3.YOUR_REGION.backblazeb2.com
# S3_ACCESS_KEY=your_b2_application_key_id
# S3_SECRET_KEY=your_b2_application_key
# S3_BUCKET_NAME=your_bucket_name
# S3_REGION=YOUR_REGION

# Cloudflare R2 — use these in production
# S3_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# S3_ACCESS_KEY=your_r2_access_key_id
# S3_SECRET_KEY=your_r2_secret_access_key
# S3_BUCKET_NAME=octo-travel
# S3_REGION=auto