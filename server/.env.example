# Local dev: `cp .env.example .env`. These values match the defaults in compose.yml,
# so `docker compose up -d` works with or without a .env file.
STORAGE_BACKEND=s3

S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=octo-local
S3_SECRET_KEY=local-dev-secret-change-me
S3_BUCKET=octo-travel
S3_REGION=us-east-1

POSTGRES_DB=octo_travel
POSTGRES_USER=octo
POSTGRES_PASSWORD=octo_dev_password
POSTGRES_HOST=127.0.0.1
# Host port for Postgres. Change it (e.g. 5433) if a local Postgres already uses 5432.
POSTGRES_PORT=5432

DJANGO_SECRET_KEY = "Random ass secrete key of how many bits u want"

# Origins allowed to call the API from a browser (the Expo web dev server by default).
# Native apps are not subject to CORS. Comma separated.
# CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081


# For Prod Environment

# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# S3_ACCESS_KEY=your_r2_access_key
# S3_SECRET_KEY=your_r2_secret_key
# S3_BUCKET=your-production-bucket
# S3_REGION=auto