# Dev-only image for the Expo/Metro dev server (builds go through EAS, not Docker).
# The oven/bun image ships a non-root `bun` user at uid 1000.
FROM oven/bun:1

WORKDIR /app
RUN chown bun:bun /app
USER bun

# Dependencies first so this layer is cached until package.json / bun.lock change.
COPY --chown=bun:bun package.json bun.lock ./
RUN bun install --frozen-lockfile

EXPOSE 8081
CMD ["bun", "--bun", "run", "start", "--port", "8081"]
