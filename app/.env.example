# Copy to .env.local (git-ignored), then restart Expo with `bun start --clear`.
#
# Base URL of the Django API as seen from the device running the app.
# `localhost` only works for the web build and the iOS simulator. A phone or the
# Android emulator needs an address that reaches this machine:
#   Android emulator   http://10.0.2.2:8000
#   Phone, same Wi-Fi  http://<this machine's LAN IP>:8000   (API must listen on 0.0.0.0)
#   Phone, anywhere    the https URL of a tunnel to port 8000 (e.g. `ngrok http 8000`)
EXPO_PUBLIC_API_URL=http://localhost:8000
